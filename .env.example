# Admin auth (OTP via email — no single password needed)
ADMIN_JWT_SECRET=generate-a-random-32-char-string
# Comma-separated list of @zuper.co emails granted the super_admin role
# (merged with the baked-in MASTER_ADMIN_EMAILS list in lib/auth.ts)
SUPER_ADMIN_EMAILS=onboarding@zuper.co
# Shared password for the master admins listed in lib/auth.ts (password
# login, no OTP). IMPORTANT: until this is set, master login falls back to
# the legacy weak convention (password == the admin's own email).
MASTER_ADMIN_PASSWORD=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email — Gmail SMTP with an App Password (not your account password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=onboarding@zuper.co
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# App
NEXT_PUBLIC_APP_URL=https://compass.zuper.co

# Cron (REQUIRED for /api/cron/* to work) — Vercel sends this as
# `Authorization: Bearer <value>` to scheduled routes. The cron routes
# reject all requests when this is unset.
CRON_SECRET=
