# Admin auth (OTP via email — no single password needed)
ADMIN_JWT_SECRET=generate-a-random-32-char-string
# Comma-separated list of @zuper.co emails granted the super_admin role
SUPER_ADMIN_EMAILS=onboarding@zuper.co

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email — Gmail SMTP with an App Password (not your account password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=onboarding@zuper.co
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# App
NEXT_PUBLIC_APP_URL=https://compass.zuper.co

# Cron (optional) — Vercel sends this as `Authorization: Bearer <value>` to
# scheduled routes when set. Add the same value as a Vercel env var to lock
# down /api/cron/* routes from public access.
CRON_SECRET=
